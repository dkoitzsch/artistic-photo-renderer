{
  "id": "dream-blur",
  "name": "Analoger Traum",
  "version": "1.0.0",
  "category": "Licht & Atmosphäre",
  "description": "Verträumter Analog-Look: starke weiche Unschärfe mit schärfer gehaltenem Motiv, Leuchten heller Flächen (Halation), Lichtlecks, Geisterbild und Bewegungsspur, Farbstich in Schatten und Lichtern, tiefes Schwarz, grobe Filmkörnung mit Farbrauschen und Vignette.",
  "inputs": ["source", "focus"],
  "passes": 5,
  "implementations": {
    "preview": "webgpu",
    "final": "webgpu"
  },
  "license": {
    "commercialUse": true,
    "notes": "Eigene Implementierung (Gauß-Pyramide des Kerns, Highlight-Leuchten, Splittoning, Zufallskörnung aus Leinwandkoordinaten)."
  },
  "cost": "realtime",
  "randomized": true,
  "requires": ["saliency", "faces"],
  "reach": "max(canvasWidth, canvasHeight) * (blur + glowSize + ghostDistance + motionLength) / 100 + 16",
  "params": [
    {
      "key": "blur",
      "label": "Unschärfe",
      "hint": "% der langen Bildkante",
      "type": "float",
      "min": 0,
      "max": 12,
      "default": 3.2,
      "step": 0.1,
      "unit": "%"
    },
    {
      "key": "subjectBlur",
      "label": "Unschärfe des Motivs",
      "hint": "Anteil der Hintergrund-Unschärfe, den das Motiv (Salienz, Gesichter, Fokus) behält",
      "type": "float",
      "min": 0,
      "max": 100,
      "default": 20,
      "unit": "%"
    },
    {
      "key": "subjectKeep",
      "label": "Motiv schärfer halten",
      "type": "float",
      "min": 0,
      "max": 100,
      "default": 70,
      "unit": "%"
    },
    {
      "key": "glow",
      "label": "Leuchten",
      "hint": "Helle Flächen strahlen in die Umgebung (Halation)",
      "type": "float",
      "min": 0,
      "max": 100,
      "default": 50,
      "unit": "%"
    },
    {
      "key": "glowThreshold",
      "label": "Leuchtschwelle",
      "type": "float",
      "min": 0,
      "max": 100,
      "default": 55,
      "unit": "%"
    },
    {
      "key": "glowSize",
      "label": "Leuchtweite",
      "hint": "% der langen Bildkante",
      "type": "float",
      "min": 0.5,
      "max": 15,
      "default": 4,
      "step": 0.1,
      "unit": "%"
    },
    {
      "key": "glowColor",
      "label": "Farbe des Leuchtens",
      "type": "color",
      "default": [1, 0.52, 0.28]
    },
    {
      "key": "leak",
      "label": "Lichtleck",
      "type": "float",
      "min": 0,
      "max": 100,
      "default": 0,
      "unit": "%"
    },
    {
      "key": "leakAngle",
      "label": "Richtung des Lichtlecks",
      "type": "angle",
      "default": 20
    },
    {
      "key": "leakColor",
      "label": "Farbe des Lichtlecks",
      "type": "color",
      "default": [1, 0.35, 0.2]
    },
    {
      "key": "ghost",
      "label": "Geisterbild",
      "hint": "Zweites, blasses Abbild des Motivs, versetzt",
      "type": "float",
      "min": 0,
      "max": 100,
      "default": 0,
      "unit": "%"
    },
    {
      "key": "ghostDistance",
      "label": "Abstand des Geisterbilds",
      "hint": "% der langen Bildkante",
      "type": "float",
      "min": 0.5,
      "max": 20,
      "default": 6,
      "step": 0.1,
      "unit": "%"
    },
    {
      "key": "motion",
      "label": "Bewegungsspur",
      "hint": "Das Motiv verwischt in Richtung des Versatzes",
      "type": "float",
      "min": 0,
      "max": 100,
      "default": 0,
      "unit": "%"
    },
    {
      "key": "motionLength",
      "label": "Länge der Spur",
      "hint": "% der langen Bildkante",
      "type": "float",
      "min": 0.5,
      "max": 20,
      "default": 5,
      "step": 0.1,
      "unit": "%"
    },
    {
      "key": "driftAngle",
      "label": "Richtung von Geisterbild und Spur",
      "type": "angle",
      "default": 10
    },
    {
      "key": "tone",
      "label": "Farbstich",
      "type": "float",
      "min": 0,
      "max": 100,
      "default": 45,
      "unit": "%"
    },
    {
