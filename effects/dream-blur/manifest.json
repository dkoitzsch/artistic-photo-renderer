      "type": "float",
      "min": 0,
      "max": 100,
      "default": 45,
      "unit": "%"
    },
    {
      "key": "grainSize",
      "label": "Korngröße",
      "hint": "% der langen Bildkante",
      "type": "float",
      "min": 0.03,
      "max": 0.5,
      "default": 0.09,
      "step": 0.01,
      "unit": "%"
    },
    {
      "key": "grainColor",
      "label": "Farbrauschen",
      "type": "float",
      "min": 0,
      "max": 100,
      "default": 35,
      "unit": "%"
    },
    {
      "key": "vignette",
      "label": "Vignette",
      "type": "float",
      "min": 0,
      "max": 100,
      "default": 40,
      "unit": "%"
    }
  ],
  "visibleIf": {
    "glowThreshold": "glow!=0",
    "glowSize": "glow!=0",
    "glowColor": "glow!=0",
    "leakAngle": "leak!=0",
    "leakColor": "leak!=0",
    "ghostDistance": "ghost!=0",
    "motionLength": "motion!=0",
    "grainSize": "grain!=0",
