{
  "id": "color-overlay",
  "name": "Farb-Overlay",
  "version": "1.0.0",
  "category": "Farbe",
  "description": "Farbe mit Mischmodus und Deckkraft über das Bild legen; optional Duotone (Schatten- und Lichterfarbe).",
  "inputs": ["source"],
  "passes": 1,
  "implementations": {
    "preview": "webgpu",
    "final": "webgpu"
  },
  "license": {
    "commercialUse": true,
    "notes": "Eigene Implementierung (Mischmodi, Duoton)."
  },
  "cost": "realtime",
  "randomized": false,
  "requires": [],
  "params": [
    {
      "key": "color",
      "label": "Farbe",
      "type": "color",
      "default": [0.86, 0.47, 0.27]
    },
    {
      "key": "opacity",
      "label": "Deckkraft",
      "type": "float",
      "min": 0,
      "max": 100,
      "default": 35,
      "unit": "%"
    },
    {
      "key": "mode",
      "label": "Mischmodus",
      "type": "enum",
      "options": [
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "multiply",
          "label": "Multiplizieren"
        },
        {
          "value": "screen",
          "label": "Negativ multiplizieren"
        },
        {
          "value": "overlay",
          "label": "Ineinanderkopieren"
        },
        {
          "value": "soft-light",
          "label": "Weiches Licht"
        },
        {
          "value": "color",
          "label": "Farbe"
        },
        {
          "value": "hue",
          "label": "Farbton"
        }
      ],
      "default": "normal"
    },
    {
      "key": "contrast",
      "label": "Kontrast",
      "type": "float",
      "min": -100,
      "max": 100,
      "default": 0
    },
    {
      "key": "duotone",
      "label": "Duotone",
      "type": "bool",
      "default": false
    },
    {
      "key": "shadowColor",
      "label": "Schattenfarbe",
      "type": "color",
      "default": [0.1, 0.12, 0.3]
    },
    {
      "key": "highlightColor",
      "label": "Lichterfarbe",
      "type": "color",
      "default": [1.0, 0.85, 0.6]
    }
  ],
  "visibleIf": {
    "color": "!duotone",
    "shadowColor": "duotone",
    "highlightColor": "duotone"
  },
  "presets": [
    {
      "name": "Warmer Abend",
      "values": {
        "color": [0.95, 0.6, 0.3],
        "opacity": 30,
        "mode": "soft-light",
        "duotone": false
      }
    },
    {
      "name": "Nachtblau (Duoton)",
      "values": {
        "duotone": true,
        "shadowColor": [0.05, 0.07, 0.2],
        "highlightColor": [0.7, 0.85, 1.0]
      }
    }
  ]
}
