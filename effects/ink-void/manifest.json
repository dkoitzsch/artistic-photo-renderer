{
  "id": "ink-void",
  "name": "Schwarze Leere",
  "version": "1.0.0",
  "category": "Malerei",
  "description": "Hochkontrastiges Schwarzweiß wie Kreide auf Schwarz: Das Gesicht wird zu einer schwarzen Leere mit verwirbelten Tuschefahnen, Randlicht, Kreidestruktur und feinen weißen Spritzern (Gemälde und Fotos mit ausgelöschtem Gesicht).",
  "inputs": ["source", "focus"],
  "passes": 1,
  "implementations": {
    "preview": "webgpu",
    "final": "webgpu"
  },
  "license": {
    "commercialUse": true,
    "notes": "Eigene Implementierung (Domänenverwirbelung mit fraktalem Rauschen, Schlieren entlang des Maskengradienten, Tonwertkurve, Randlicht aus der Kantenkarte, Spritzer aus Zufall je Zelle)."
  },
  "cost": "realtime",
  "randomized": true,
  "requires": ["edges", "saliency", "faces"],
  "reach": "max(canvasWidth, canvasHeight) * (tendrilLength / 100 + turbulence / 800 + 0.04) + 16",
  "params": [
    {
      "key": "coverage",
      "label": "Größe der Leere",
      "type": "float",
      "min": 0,
      "max": 100,
      "default": 50,
      "unit": "%"
    },
    {
      "key": "subjectBias",
      "label": "Auf Gesicht und Motiv beschränken",
      "hint": "Gesichter, Salienz und Fokuskarte bestimmen, wo die Leere sitzt",
      "type": "float",
      "min": 0,
      "max": 100,
      "default": 80,
      "unit": "%"
    },
    {
      "key": "voidShiftX",
      "label": "Leere verschieben (waagerecht)",
      "hint": "% der langen Bildkante",
      "type": "float",
      "min": -30,
      "max": 30,
      "default": 0,
      "step": 0.5,
      "unit": "%"
    },
    {
      "key": "voidShiftY",
      "label": "Leere verschieben (senkrecht)",
      "hint": "% der langen Bildkante, positiv = nach unten",
