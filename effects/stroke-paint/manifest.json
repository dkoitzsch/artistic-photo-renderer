{
  "id": "stroke-paint",
  "name": "Pinselstriche",
  "version": "1.0.0",
  "category": "Malerei",
  "description": "Malt das Bild Strich für Strich nach – von großen zu kleinen Pinseln, die Striche folgen den Formen. Die Strichdaten nutzt der Malplan für die Strichführung.",
  "inputs": ["source"],
  "passes": 1,
  "implementations": { "preview": "browser-cpu", "final": "browser-cpu" },
  "license": {
    "commercialUse": true,
    "notes": "Eigene Implementierung nach Hertzmann (1998): Painterly Rendering with Curved Brush Strokes of Multiple Sizes (Verfahren, kein Fremdcode)."
  },
  "cost": "slow",
  "randomized": true,
  "requires": ["flow"],
  "params": [
    {
      "key": "brushSize",
      "label": "Größter Pinsel",
      "type": "float",
      "min": 4,
      "max": 160,
      "default": 36,
      "unit": "px",
      "scale": "log"
    },
    {
      "key": "levels",
      "label": "Pinselgrößen",
      "hint": "Anzahl Durchgänge, jeweils halbe Pinselbreite",
      "type": "int",
      "min": 1,
      "max": 5,
      "default": 3
    },
    {
      "key": "detail",
      "label": "Detail",
      "hint": "Höher = mehr kleine Striche in Details",
      "type": "float",
      "min": 0,
      "max": 100,
      "default": 55,
      "unit": "%"
    },
    {
      "key": "length",
      "label": "Strichlänge",
      "hint": "in Pinselbreiten",
      "type": "int",
      "min": 1,
      "max": 16,
      "default": 8
    },
    {
      "key": "curvature",
      "label": "Krümmung",
      "type": "float",
      "min": 0,
      "max": 100,
      "default": 50,
      "unit": "%"
    },
    {
      "key": "direction",
      "label": "Strichrichtung",
      "type": "enum",
      "options": [
        { "value": "flow", "label": "Entlang der Formen" },
        { "value": "gradient", "label": "Quer zum Hell-Dunkel" }
      ],
      "default": "flow"
    },
    {
      "key": "opacity",
      "label": "Deckkraft der Striche",
      "type": "float",
      "min": 30,
      "max": 100,
      "default": 92,
      "unit": "%",
      "group": "Erweitert"
    },
    {
      "key": "jitter",
      "label": "Farbstreuung",
      "type": "float",
      "min": 0,
      "max": 100,
      "default": 25,
      "unit": "%",
      "group": "Erweitert"
    },
    {
      "key": "bristles",
      "label": "Borstenstruktur",
      "type": "float",
      "min": 0,
      "max": 100,
      "default": 35,
      "unit": "%",
      "group": "Erweitert"
    },
    {
      "key": "ground",
      "label": "Malgrund",
      "type": "color",
      "default": [0.86, 0.8, 0.7],
      "group": "Erweitert"
    }
  ],
  "presets": [
    {
      "name": "Impressionistisch",
      "values": { "brushSize": 24, "levels": 3, "detail": 45, "length": 6, "jitter": 45 }
    },
    {
      "name": "Expressiv, große Pinsel",
      "values": { "brushSize": 80, "levels": 2, "detail": 30, "length": 12, "curvature": 80 }
    },
    {
      "name": "Feine Studie",
      "values": { "brushSize": 16, "levels": 4, "detail": 75, "length": 5, "jitter": 10 }
    }
  ]
}
