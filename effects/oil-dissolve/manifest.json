{
  "id": "oil-dissolve",
  "name": "Auflösende Ölfarbe",
  "version": "1.0.0",
  "category": "Malerei",
  "description": "Die Figur löst sich wie nasse Ölfarbe auf: verwirbelt und verwischt, mit goldenen Rändern an den Löchern ins Dunkel, davonfliegenden Flocken und Bläschen, tiefem Schwarz und Pinselstruktur (zeitgenössische Ölmalerei, auflösende Porträts).",
  "inputs": ["source", "focus"],
  "passes": 1,
  "implementations": {
    "preview": "webgpu",
    "final": "webgpu"
  },
  "license": {
    "commercialUse": true,
    "notes": "Eigene Implementierung (Domänenverwirbelung mit fraktalem Rauschen, gerichtetes Wischen, Rauschschwellen, Flocken und Bläschen aus Zufall je Zelle, prozedurale Pinselstruktur)."
  },
  "cost": "realtime",
  "randomized": true,
  "requires": ["saliency", "faces"],
  "reach": "max(canvasWidth, canvasHeight) * (swirl / 800 + smearLength / 100 + fleckSize / 40) + 16",
  "params": [
    {
      "key": "dissolve",
      "label": "Auflösung",
      "type": "float",
      "min": 0,
      "max": 100,
      "default": 55,
      "unit": "%"
    },
    {
      "key": "dissolveAngle",
      "label": "Richtung der Auflösung",
      "hint": "Die Figur löst sich zu dieser Seite hin auf",
      "type": "angle",
      "default": 200
    },
    {
      "key": "subjectBias",
      "label": "Auf das Motiv beschränken",
      "hint": "Salienz, Gesichter und Fokuskarte: der Hintergrund bleibt unberührt",
      "type": "float",
      "min": 0,
      "max": 100,
      "default": 60,
      "unit": "%"
    },
    {
      "key": "backdrop",
      "label": "Hintergrund abdunkeln",
