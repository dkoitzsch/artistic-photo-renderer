{
  "id": "tsp-art",
  "name": "Eine Linie (TSP-Art)",
  "version": "1.0.0",
  "category": "Geometrisch & Abstrakt",
  "description": "Das ganze Bild als eine einzige, sich nie kreuzende Linie: Punkte nach Dunkelheit, verbunden zu einer kurzen Rundreise.",
  "inputs": ["source"],
  "passes": 1,
  "implementations": { "preview": "browser-cpu", "final": "browser-cpu" },
  "license": {
    "commercialUse": true,
    "notes": "Eigene Implementierung (TSP-Art nach Kaplan & Bosch 2005: Punkte nach Dunkelheit, Nächster-Nachbar-Tour, 2-opt)."
  },
  "cost": "slow",
  "randomized": true,
  "requires": [],
  "params": [
    {
      "key": "points",
      "label": "Punktanzahl",
      "type": "int",
      "min": 300,
      "max": 20000,
      "default": 4000,
      "scale": "log"
    },
    {
      "key": "width",
      "label": "Linienstärke",
      "type": "float",
      "min": 0.3,
      "max": 6,
      "default": 1.2,
      "step": 0.1,
      "unit": "px"
    },
    {
      "key": "contrast",
      "label": "Kontrast",
      "type": "float",
      "min": 0,
      "max": 100,
      "default": 50,
      "unit": "%"
    },
    { "key": "ink", "label": "Linienfarbe", "type": "color", "default": [0.08, 0.08, 0.1] },
    { "key": "paper", "label": "Papier", "type": "color", "default": [0.97, 0.95, 0.9] },
    {
      "key": "optimize",
      "label": "Entwirren",
      "hint": "Durchgänge der 2-opt-Optimierung (mehr = weniger Kreuzungen, langsamer)",
      "type": "int",
      "min": 0,
      "max": 24,
      "default": 10,
      "group": "Erweitert"
    }
  ],
  "presets": [
    { "name": "Feiner Strich", "values": { "points": 9000, "width": 0.7, "contrast": 60 } },
    { "name": "Grob", "values": { "points": 1200, "width": 2.4, "contrast": 40 } },
    { "name": "Weiß auf Schwarz", "values": { "ink": [0.95, 0.94, 0.9], "paper": [0.06, 0.06, 0.07] } }
  ]
}
