{
  "id": "wet-glass",
  "name": "Beschlagene Scheibe",
  "version": "1.0.0",
  "category": "Licht & Atmosphäre",
  "description": "Das Bild wird durch eine beschlagene, regennasse Scheibe gesehen: weicher Beschlag in Feldern, freigewischte Stellen, senkrechte Schlieren, milchiger Schleier, Tropfen mit umgekehrtem Spiegelbild und Laufspuren (Straßenfotografie hinter nassem Glas).",
  "inputs": ["source", "focus"],
  "passes": 4,
  "implementations": { "preview": "webgpu", "final": "webgpu" },
  "license": {
    "commercialUse": true,
    "notes": "Eigene Implementierung (Gauß-Pyramide des Kerns, Beschlagfeld aus verzerrtem fraktalem Rauschen, Tropfen als Linsen mit invertierter Abbildung, Laufspuren aus Zufall je Zelle)."
  },
  "cost": "realtime",
  "randomized": true,
  "requires": ["saliency", "faces"],
  "reach": "max(canvasWidth, canvasHeight) * (fogBlur * 1.2 + smearLength + dropSize * 12 + 4) / 100 + 16",
  "params": [
    {
      "key": "fog",
      "label": "Beschlag",
      "type": "float",
      "min": 0,
      "max": 100,
      "default": 55,
      "unit": "%"
    },
    {
      "key": "fogBlur",
      "label": "Unschärfe im Beschlag",
      "hint": "% der langen Bildkante",
      "type": "float",
      "min": 0.5,
      "max": 10,
      "default": 3,
      "step": 0.1,
      "unit": "%"
    },
    {
      "key": "fogSize",
      "label": "Größe der Beschlagfelder",
      "hint": "% der langen Bildkante",
      "type": "float",
      "min": 5,
      "max": 60,
      "default": 25,
      "unit": "%"
    },
    {
      "key": "wipe",
      "label": "Freigewischte Stellen",
      "hint": "Senkrechte Wischspuren, durch die das Bild klar bleibt",
      "type": "float",
      "min": 0,
      "max": 100,
      "default": 35,
      "unit": "%"
    },
    {
      "key": "subjectClear",
      "label": "Motiv klarer",
