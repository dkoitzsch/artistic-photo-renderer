{
  "id": "gaussian-blur",
  "name": "Gauß-Blur",
  "version": "1.0.0",
  "category": "Unschärfe",
  "description": "Weiche Unschärfe mit Radius bis 300 px; große Radien laufen über eine Pyramide in Echtzeit.",
  "inputs": ["source"],
  "passes": 4,
  "params": [
    {
      "key": "radius",
      "label": "Stärke",
      "hint": "Radius in px (≈ 3 σ)",
      "type": "float",
      "min": 0,
      "max": 300,
      "default": 20,
      "step": 0.1,
      "unit": "px",
      "scale": "log"
    },
    {
      "key": "edge",
      "label": "Kantenbehandlung",
      "type": "enum",
      "options": [
        { "value": "mirror", "label": "Spiegeln" },
        { "value": "clamp", "label": "Klemmen" },
        { "value": "transparent", "label": "Transparent" }
      ],
      "default": "mirror"
    }
  ],
  "reach": "radius"
}
