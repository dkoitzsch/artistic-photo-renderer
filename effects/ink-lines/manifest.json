{
  "id": "ink-lines",
  "name": "Tusche-Linien",
  "version": "1.0.0",
  "category": "Zeichnung & Grafik",
  "description": "Linienzeichnung wie mit Feder und Tusche (XDoG, entlang der Kantenrichtung geglättet) – auf Papier oder über dem Bild.",
  "inputs": ["source"],
  "passes": 6,
  "implementations": {
    "preview": "webgpu",
    "final": "webgpu"
  },
  "license": {
    "commercialUse": true,
    "notes": "Eigene Implementierung nach Winnemöller (2011) XDoG und Kang et al. (2007) Flow-based DoG (Verfahren, kein Fremdcode)."
  },
  "cost": "realtime",
  "randomized": true,
  "requires": ["edges"],
  "params": [
    {
      "key": "thickness",
      "label": "Linienstärke",
      "type": "float",
      "min": 0.5,
      "max": 8,
      "default": 1.3,
      "step": 0.1,
      "unit": "px"
    },
    {
      "key": "detail",
      "label": "Detail",
      "type": "float",
      "min": 0,
      "max": 100,
      "default": 55,
      "unit": "%"
    },
    {
      "key": "threshold",
      "label": "Schwellwert",
      "type": "float",
      "min": 0,
      "max": 100,
      "default": 50,
      "unit": "%"
    },
    {
      "key": "fill",
      "label": "Flächen",
      "hint": "0 % = nur Linien, höher = dunkle Bereiche als Tuschefläche",
      "type": "float",
      "min": 0,
      "max": 100,
      "default": 10,
      "unit": "%"
    },
    {
      "key": "softness",
      "label": "Weichheit",
      "hint": "0 % = harte Tusche, 100 % = weiche Bleistiftlinie",
      "type": "float",
      "min": 0,
      "max": 100,
      "default": 30,
      "unit": "%"
    },
    {
      "key": "flow",
      "label": "Linienfluss",
      "hint": "Glättung entlang der Kanten – zusammenhängendere Striche",
      "type": "float",
      "min": 0,
      "max": 100,
      "default": 50,
      "unit": "%"
    },
    {
      "key": "roughness",
      "label": "Ausfransung",
      "type": "float",
      "min": 0,
      "max": 100,
      "default": 15,
      "unit": "%"
    },
    {
      "key": "lineColor",
      "label": "Linienfarbe",
      "type": "color",
      "default": [0.07, 0.06, 0.06]
    },
    {
      "key": "paperColor",
      "label": "Papierfarbe",
      "type": "color",
      "default": [0.97, 0.95, 0.9]
    },
    {
      "key": "mode",
      "label": "Ausgabe",
      "type": "enum",
      "options": [
        {
          "value": "paper",
          "label": "Auf Papier"
        },
        {
          "value": "overlay",
          "label": "Über dem Bild"
        }
      ],
      "default": "paper"
    }
  ],
  "visibleIf": {
    "paperColor": "mode=paper"
  },
  "reach": "thickness * 8 + 12",
  "presets": [
    {
      "name": "Feder",
      "values": {
        "thickness": 1.1,
        "detail": 60,
        "threshold": 50,
        "softness": 15,
        "flow": 55,
        "roughness": 10,
        "mode": "paper",
        "fill": 8
      }
    },
    {
      "name": "Bleistift",
      "values": {
        "thickness": 0.9,
        "detail": 45,
        "threshold": 60,
        "softness": 80,
        "flow": 35,
        "roughness": 30,
        "lineColor": [0.25, 0.25, 0.27],
        "mode": "paper",
        "fill": 25
      }
    },
    {
      "name": "Konturen über dem Bild",
      "values": {
        "thickness": 1.8,
        "detail": 50,
        "threshold": 45,
        "softness": 20,
        "flow": 60,
        "roughness": 5,
        "mode": "overlay",
        "fill": 0
      }
    },
    {
      "name": "Sepia-Skizze",
      "values": {
        "thickness": 1.4,
        "detail": 65,
        "threshold": 55,
        "softness": 40,
        "flow": 50,
        "roughness": 25,
        "lineColor": [0.32, 0.18, 0.08],
        "paperColor": [0.95, 0.89, 0.76],
        "mode": "paper",
        "fill": 20
      }
    }
  ]
}
